  <Source dwd:design-time-name="06031714-e5f4-4fd1-8e15-58d31e7f7cc2">
    <DataSourceViewID>DSV_ElectroHogarNorte</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="d64cb427-b58a-452a-b4a3-4d853b2fea7c">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T05:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T05:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;


/* Margen bruto */

CREATE MEMBER CURRENTCUBE.[Measures].[Margen Bruto %]
AS
IIF(
    IsEmpty([Measures].[Ventas Netas])
    OR [Measures].[Ventas Netas] = 0,
    NULL,
    [Measures].[Utilidad Bruta]
    / [Measures].[Ventas Netas]
),
FORMAT_STRING = "0.00%",
VISIBLE = 1;


/* Ticket promedio neto */

CREATE MEMBER CURRENTCUBE.[Measures].[Ticket Promedio Neto]
AS
IIF(
    IsEmpty([Measures].[Numero de Ventas])
    OR [Measures].[Numero de Ventas] = 0,
    NULL,
    [Measures].[Ventas Netas]
    / [Measures].[Numero de Ventas]
),
FORMAT_STRING = "#,##0.00",
VISIBLE = 1;


/* Ventas del periodo anterior */

CREATE MEMBER CURRENTCUBE.[Measures].[Ventas Periodo Anterior]
AS
CASE
    WHEN [Dim Fecha].[Mes].CurrentMember.Level.Ordinal = 1
    THEN
        (
            [Measures].[Ventas Netas],
            [Dim Fecha].[Mes].CurrentMember.PrevMember,
            [Dim Fecha].[Anio].DefaultMember,
            [Dim Fecha].[Trimestre].DefaultMember,
            [Dim Fecha].[Fecha].DefaultMember,
            [Dim Fecha].[Calendario].DefaultMember
        )

    WHEN [Dim Fecha].[Trimestre].CurrentMember.Level.Ordinal = 1
    THEN
        (
            [Measures].[Ventas Netas],
            [Dim Fecha].[Trimestre].CurrentMember.PrevMember,
            [Dim Fecha].[Anio].DefaultMember,
            [Dim Fecha].[Mes].DefaultMember,
            [Dim Fecha].[Fecha].DefaultMember,
            [Dim Fecha].[Calendario].DefaultMember
        )

    WHEN [Dim Fecha].[Anio].CurrentMember.Level.Ordinal = 1
    THEN
        (
            [Measures].[Ventas Netas],
            [Dim Fecha].[Anio].CurrentMember.PrevMember,
            [Dim Fecha].[Trimestre].DefaultMember,
            [Dim Fecha].[Mes].DefaultMember,
            [Dim Fecha].[Fecha].DefaultMember,
            [Dim Fecha].[Calendario].DefaultMember
        )

    ELSE NULL
END,
FORMAT_STRING = "#,##0.00",
VISIBLE = 1;


/* Variacion porcentual de ventas */

CREATE MEMBER CURRENTCUBE.[Measures].[Variacion Ventas %]
AS
IIF(
    IsEmpty([Measures].[Ventas Periodo Anterior])
    OR [Measures].[Ventas Periodo Anterior] = 0,
    NULL,
    (
        CoalesceEmpty([Measures].[Ventas Netas], 0)
        - [Measures].[Ventas Periodo Anterior]
    )
    / [Measures].[Ventas Periodo Anterior]
),
FORMAT_STRING = "0.00%",
VISIBLE = 1;


/* Participacion de ventas por distrito */

CREATE MEMBER CURRENTCUBE.[Measures].[Participacion Ventas Distrito %]
AS
IIF(
    IsEmpty(
        (
            [Measures].[Ventas Netas],
            [Dim Cliente].[Distrito].DefaultMember
        )
    )
    OR
    (
        [Measures].[Ventas Netas],
        [Dim Cliente].[Distrito].DefaultMember
    ) = 0,
    NULL,
    [Measures].[Ventas Netas]
    /
    (
        [Measures].[Ventas Netas],
        [Dim Cliente].[Distrito].DefaultMember
    )
),
FORMAT_STRING = "0.00%",
VISIBLE = 1;</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>